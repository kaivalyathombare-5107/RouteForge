// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  firebaseUid  String             @unique @map("firebase_uid")
  email        String             @unique
  displayName  String?            @map("display_name")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  profile      TravellerProfile?
  preferences  TravelPreference?

  @@map("users")
}

model TravellerProfile {
  id                          String    @id @default(uuid())
  userId                      String    @unique @map("user_id")
  fullName                    String    @map("full_name")
  phoneNumber                 String    @map("phone_number")
  homeCity                    String    @map("home_city")
  ageGroup                    String    @map("age_group")
  preferredCurrency           String    @default("INR") @map("preferred_currency")
  foodPreference              String?   @map("food_preference")
  accessibilityRequirements   String?   @map("accessibility_requirements")
  frequentTravellerIdentifiers Json?    @map("frequent_traveller_identifiers")
  emergencyContactName        String?   @map("emergency_contact_name")
  emergencyContactPhone       String?   @map("emergency_contact_phone")
  emergencyContactRelation    String?   @map("emergency_contact_relation")
  isComplete                  Boolean   @default(false) @map("is_complete")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("traveller_profiles")
}

model TravelPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  travelBudget           String   @map("travel_budget")
  preferredTransport     String   @map("preferred_transport")
  preferredCabinClass    String   @map("preferred_cabin_class")
  seatPreference         String   @map("seat_preference")
  hotelCategory          String   @map("hotel_category")
  preferredDepartureTime String   @map("preferred_departure_time")
  maxTravelDurationHours Int      @default(12) @map("max_travel_duration_hours")
  maxConnections         Int      @default(1) @map("max_connections")
  flexibilityPreference  String   @default("moderate") @map("flexibility_preference")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}

model ProviderConnection {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  providerId        String    @map("provider_id")
  connectionState   String    @default("NOT_CONNECTED") @map("connection_state")
  accountIdentifier String?   @map("account_identifier")
  connectedAt       DateTime? @map("connected_at")
  expiresAt         DateTime? @map("expires_at")
  lastSyncAt        DateTime? @map("last_sync_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  tokens ProviderToken[]

  @@unique([userId, providerId])
  @@map("provider_connections")
}

model ProviderToken {
  id                   String    @id @default(uuid())
  providerConnectionId String    @map("provider_connection_id")
  tokenType            String    @map("token_type") // e.g., 'access_token', 'refresh_token'
  encryptedToken       String    @map("encrypted_token")
  expiresAt            DateTime? @map("expires_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  connection ProviderConnection @relation(fields: [providerConnectionId], references: [id], onDelete: Cascade)

  @@map("provider_tokens")
}

model BookingIntent {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  journeyId           String?  @map("journey_id")
  provider            String   @map("provider")
  selectedOption      Json     @map("selected_option")
  providerReference   String?  @map("provider_reference")
  bookingMethod       String   @map("booking_method") // OFFICIAL_PARTNER, DIRECT_API, DEEP_LINK
  deepLinkUrl         String?  @map("deep_link_url")
  status              String   @default("INITIATED") @map("status") // INITIATED, REDIRECTED, CONFIRMED, ABANDONED
  requestedParameters Json?    @map("requested_parameters")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("booking_intents")
}

model Booking {
  id                 String           @id @default(uuid())
  userId             String           @map("user_id")
  bookingReference   String           @unique @map("booking_reference") // PNR / Ticket Ref
  provider           String           @map("provider")
  title              String           @map("title")
  status             String           @default("CONFIRMED") @map("status") // CONFIRMED, TICKETED, ACTIVE, COMPLETED, DISRUPTED, CANCELLED
  totalPrice         Float            @map("total_price")
  currency           String           @default("INR") @map("currency")
  passengers         Json             @map("passengers")
  cancellationPolicy Json?            @map("cancellation_policy")
  modificationPolicy Json?            @map("modification_policy")
  disruptionShield   String?          @map("disruption_shield")
  provenance         Json?            @map("provenance")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  lastVerifiedAt     DateTime?        @map("last_verified_at")

  segments           BookingSegment[]

  @@map("bookings")
}

model BookingSegment {
  id            String   @id @default(uuid())
  bookingId     String   @map("booking_id")
  segmentOrder  Int      @default(0) @map("segment_order")
  transportType String   @map("transport_type") // flight, train, bus, transfer, stay
  operator      String   @map("operator")
  serviceNumber String   @map("service_number")
  origin        String   @map("origin")
  destination   String   @map("destination")
  depTime       String   @map("dep_time")
  arrTime       String   @map("arr_time")
  seatClass     String?  @map("seat_class")
  status        String   @default("CONFIRMED") @map("status")
  pnr           String?  @map("pnr")
  sourceType    String   @default("PARTNER_API") @map("source_type")
  createdAt     DateTime @default(now()) @map("created_at")

  booking       Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("booking_segments")
}


