// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(uuid())
  firebaseUid  String             @unique @map("firebase_uid")
  email        String             @unique
  displayName  String?            @map("display_name")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  profile      TravellerProfile?
  preferences  TravelPreference?

  @@map("users")
}

model TravellerProfile {
  id                          String    @id @default(uuid())
  userId                      String    @unique @map("user_id")
  fullName                    String    @map("full_name")
  phoneNumber                 String    @map("phone_number")
  homeCity                    String    @map("home_city")
  ageGroup                    String    @map("age_group")
  preferredCurrency           String    @default("INR") @map("preferred_currency")
  foodPreference              String?   @map("food_preference")
  accessibilityRequirements   String?   @map("accessibility_requirements")
  frequentTravellerIdentifiers Json?    @map("frequent_traveller_identifiers")
  emergencyContactName        String?   @map("emergency_contact_name")
  emergencyContactPhone       String?   @map("emergency_contact_phone")
  emergencyContactRelation    String?   @map("emergency_contact_relation")
  isComplete                  Boolean   @default(false) @map("is_complete")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("traveller_profiles")
}

model TravelPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  travelBudget           String   @map("travel_budget")
  preferredTransport     String   @map("preferred_transport")
  preferredCabinClass    String   @map("preferred_cabin_class")
  seatPreference         String   @map("seat_preference")
  hotelCategory          String   @map("hotel_category")
  preferredDepartureTime String   @map("preferred_departure_time")
  maxTravelDurationHours Int      @default(12) @map("max_travel_duration_hours")
  maxConnections         Int      @default(1) @map("max_connections")
  flexibilityPreference  String   @default("moderate") @map("flexibility_preference")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("travel_preferences")
}
